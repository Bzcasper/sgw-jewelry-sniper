# Copy to .env — never commit real tokens (see RULES.md #19)
# buyerapi auth (from frx-isolated Firefox 153 via POST SignIn/Login)
BEARER=eyJ...accessToken...
REFRESH_TOKEN=...
CLIENT_IP=1.1.1.1
BUYER_ID=12345

# sniper tuning
ITEMS=275585046:30,275772810:50
FIRE_BEFORE_MS=900
MAX_BIDS_JSON=[{"itemId":275585046,"sellerId":361,"max":30}]

# census
CENSUS_API_KEY=DEMO_KEY
CENSUS_GEO_CACHE_DAYS=30

# scanner
LOW_PRICE=10
HIGH_PRICE=5000
JEWELRY_CAT_IDS=87
JEWELRY_SUBCATS=88,2240
SEARCH_DESCRIPTIONS=true
THROTTLE_MS=600
PAGE_SIZE=40

# db
DATABASE_URL=sqlite:./data/sgw_jewelry.db
DATABASE_URL_PG=postgres://user:pass@localhost:5432/sgw

# infra
RUST_LOG=info
NODE_ENV=production
